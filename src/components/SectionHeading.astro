---
interface Props {
  eyebrow: string;
  title: string;
  note?: string;
}

const { eyebrow, title, note } = Astro.props;
---

<header class="section-heading reveal">
  <div class="section-heading__copy">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  {note && <p class="section-heading__note">{note}</p>}
</header>
