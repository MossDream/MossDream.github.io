---
import type { PostEntry } from '../lib/content';
import { formatDate, postHref, readingMinutes } from '../lib/content';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  post: PostEntry;
  index: number;
  variant?: 'feature' | 'row';
}

const { post, index, variant = 'feature' } = Astro.props;
const category = post.data.categories.at(-1) ?? 'NOTE';
const serial = String(index).padStart(2, '0');
---

<article class:list={['post-card', `post-card--${variant}`, 'reveal']} data-track={category}>
  <a class="post-card__link" href={postHref(post)} aria-label={`阅读《${post.data.title}》`}>
    <div class="post-card__visual" aria-hidden="true">
      <span class="post-card__serial">N°{serial}</span>
      <span class="post-card__glyph">{category.slice(0, 2)}</span>
      <span class="post-card__trace"></span>
    </div>
    <div class="post-card__content">
      <div class="post-card__meta">
        <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
        <span>{category}</span>
        <span>{readingMinutes(post)} MIN</span>
      </div>
      <h3>{post.data.title}</h3>
      <p>{post.data.excerpt}</p>
      <span class="post-card__action">READ NOTE <ArrowIcon direction="up-right" /></span>
    </div>
  </a>
</article>
