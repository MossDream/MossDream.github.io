<dialog class="search-dialog" id="search-dialog" aria-labelledby="search-title" data-search-dialog>
  <div class="search-dialog__shell">
    <header class="search-dialog__header">
      <div>
        <p class="eyebrow">SEARCH / LOCAL INDEX</p>
        <h2 id="search-title">搜索文章</h2>
      </div>
      <button class="search-dialog__close" type="button" data-search-close aria-label="关闭搜索">×</button>
    </header>
    <label class="search-field">
      <span class="sr-only">输入标题、分类或关键词</span>
      <input type="search" autocomplete="off" placeholder="输入标题、分类或关键词…" data-search-input />
      <span aria-hidden="true">↵</span>
    </label>
    <div class="search-dialog__status" role="status" aria-live="polite" data-search-status>输入关键词开始搜索</div>
    <ol class="search-results" data-search-results></ol>
  </div>
</dialog>
