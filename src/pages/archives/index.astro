---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InlinePostPager from '../../components/InlinePostPager.astro';
import PageHero from '../../components/PageHero.astro';
import { getPosts } from '../../lib/content';

const allPosts = await getPosts();
const archiveYears = [...new Set(allPosts.map((post) => post.data.published.getFullYear()))].map((year) => ({
  year,
  count: allPosts.filter((post) => post.data.published.getFullYear() === year).length,
  months: [...new Set(
    allPosts
      .filter((post) => post.data.published.getFullYear() === year)
      .map((post) => post.data.published.getMonth() + 1),
  )]
    .sort((left, right) => right - left)
    .map((month) => ({
      month,
      count: allPosts.filter((post) => post.data.published.getFullYear() === year && post.data.published.getMonth() + 1 === month).length,
    })),
}));
---

<BaseLayout title="文章归档" description="MossDream 的全部计算机科学学习笔记，按时间排列。" pageKind="listing">
  <PageHero eyebrow="ARCHIVE" title="文章归档" description="按时间回看每一次记录现场。" count={allPosts.length} mascotVariant="archive" />
  <section class="listing-shell content-track">
    <nav class="archive-timeline reveal" aria-label="按发布时间浏览">
      <header class="archive-timeline__heading">
        <p class="eyebrow">BROWSE BY DATE</p>
        <p>从最近的记录开始，沿时间轴向前回看。</p>
      </header>
      <ol class="archive-timeline__years">
        {archiveYears.map(({ year, count, months }) => (
          <li class="archive-timeline__year">
            <a class="archive-timeline__year-link" href={`/archives/${year}/`}>
              <span>YEAR</span>
              <strong>{year}</strong>
              <em>{count} 篇文章</em>
            </a>
            <ol class="archive-timeline__months">
              {months.map(({ month, count: monthCount }) => {
                const monthLabel = String(month).padStart(2, '0');
                return (
                  <li>
                    <a href={`/archives/${year}/${monthLabel}/`}>
                      <span>{monthLabel}</span>
                      <strong>{month} 月</strong>
                      <em>{monthCount} 篇</em>
                    </a>
                  </li>
                );
              })}
            </ol>
          </li>
        ))}
      </ol>
    </nav>
    <InlinePostPager posts={allPosts} label="全部归档文章" />
  </section>
</BaseLayout>
