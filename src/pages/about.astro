---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import PageHero from '../components/PageHero.astro';
import mossCat from '../assets/moss-cat.png';
import { getPosts, uniqueCategories, uniqueTags } from '../lib/content';

const posts = await getPosts();
const tags = uniqueTags(posts);
const tracks = uniqueCategories(posts).filter((category) => category.path.length > 1);
---

<BaseLayout title="关于" description="关于 MossDream 与这个计算机科学学习档案。" pageKind="about">
  <PageHero eyebrow="ABOUT" title="关于这个博客，和正在学习的我。" description="这里收录课程笔记、代码复盘与阶段总结，也保留每一次理解逐渐清晰的过程。" />

  <section class="about-shell content-track">
    <div class="about-intro reveal">
      <div class="about-intro__copy">
        <p class="eyebrow">HELLO / 你好</p>
        <h2>你好，我是 MossDream。</h2>
        <p>这是一份以计算机课程学习为主的个人记录。与其把它做成简历或教程合集，我更愿意把每篇文章当作一次完整复盘：题目是什么、思路怎样展开、代码为什么这样写，以及最后还留下了哪些疑问。</p>
        <p>目前公开的内容集中在北航 OOPre、计算机组成原理、C 语言与数据结构。文章保留了当时的代码、表格和推导过程，既方便我重新回看，也希望能给正在解决相似问题的人一个可靠入口。</p>
        <p>如果想顺着时间阅读，可以从文章归档开始；如果只关心一门课程，可以从学习路径进入。项目源码与其他练习放在 GitHub。</p>
        <a class="text-link" href="https://github.com/MossDream" target="_blank" rel="noopener noreferrer">在 GitHub 查看代码 <ArrowIcon direction="up-right" /></a>
      </div>
      <figure class="about-intro__mascot" data-mascot-stage>
        <div data-mascot><Image src={mossCat} width={720} format="webp" quality={82} alt="MossDream 的猫咪吉祥物 Moss" loading="lazy" decoding="async" /></div>
        <figcaption>MOSS / 一只对代码很好奇的猫</figcaption>
      </figure>
    </div>

    <div class="about-metrics reveal">
      <div><strong>{posts.length}</strong><span>篇文章 / NOTES</span></div>
      <div><strong>{tracks.length}</strong><span>条课程路径 / TRACKS</span></div>
      <div><strong>{tags.length}</strong><span>个技术标签 / TAGS</span></div>
      <div><strong>2023</strong><span>开始记录 / SINCE</span></div>
    </div>

    <section class="about-paths" id="elsewhere" aria-labelledby="about-paths-title">
      <header class="about-paths__heading reveal">
        <p class="eyebrow">CONTACT &amp; INDEX / ELSEWHERE</p>
        <h2 id="about-paths-title">从哪里开始阅读？</h2>
        <p>按时间、课程或代码仓库选择入口，也可以通过 RSS 订阅后续文章。</p>
      </header>
      <div class="about-paths__grid">
        <a class="about-path reveal" href="/archives/">
          <p class="eyebrow">文章 / ARCHIVE</p>
          <h3>查看全部学习笔记</h3>
          <p>从最近一次复盘开始，按发布时间向前阅读。</p>
          <ArrowIcon direction="up-right" />
        </a>
        <a class="about-path reveal" href="/categories/">
          <p class="eyebrow">课程 / TRACKS</p>
          <h3>沿着课程继续</h3>
          <p>集中浏览 OOPre、计算机组成、C 与数据结构。</p>
          <ArrowIcon direction="up-right" />
        </a>
        <a class="about-path reveal" href="https://github.com/MossDream" target="_blank" rel="noopener noreferrer">
          <p class="eyebrow">代码 / GITHUB</p>
          <h3>前往代码仓库</h3>
          <p>查看练习、源码与仍在继续完善的小项目。</p>
          <ArrowIcon direction="up-right" />
        </a>
        <a class="about-path reveal" href="/rss.xml">
          <p class="eyebrow">订阅 / RSS</p>
          <h3>订阅后续更新</h3>
          <p>把新文章送进常用阅读器，不必反复刷新首页。</p>
          <ArrowIcon direction="up-right" />
        </a>
      </div>
    </section>
  </section>
</BaseLayout>
