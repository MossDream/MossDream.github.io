---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { categoryHref, getPosts, uniqueCategories } from '../../lib/content';

const posts = await getPosts();
const categories = uniqueCategories(posts);
---

<BaseLayout title="分类" description="按课程与知识路径浏览 MossDream 的学习笔记。" pageKind="taxonomy">
  <PageHero eyebrow="TRACKS" title="学习路径" description="从课程出发，把零散知识连接成系统。" count={categories.length} />
  <section class="taxonomy-grid content-track" aria-label="全部分类">
    {categories.map((category) => (
      <a class:list={['taxonomy-card', category.path.length > 1 && 'taxonomy-card--child', 'reveal']} href={categoryHref(category.path)}>
        <strong>{category.name}</strong>
        <em>{category.count} NOTES</em>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </section>
</BaseLayout>
