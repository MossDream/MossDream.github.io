---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InlinePostPager from '../../components/InlinePostPager.astro';
import PageHero from '../../components/PageHero.astro';
import { getPosts, taxonomySegment, uniqueCategories } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return uniqueCategories(posts).map((category) => {
    const categoryPosts = posts.filter((post) => category.path.every((part, index) => post.data.categories[index] === part));
    const route = category.path.map(taxonomySegment).join('/');
    return {
      params: { category: route },
      props: { path: category.path, posts: categoryPosts },
    };
  });
}

const { path, posts } = Astro.props;
const name = path.at(-1) ?? '分类';
---

<BaseLayout title={name} description={`${path.join(' / ')} 分类下的全部文章。`} pageKind="listing">
  <PageHero eyebrow="TRACK" title={name} description={path.join(' / ')} count={posts.length} />
  <section class="listing-shell content-track">
    <InlinePostPager posts={posts} label={`${name} 分类文章`} />
  </section>
</BaseLayout>
